# UdyamAI Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://udyam_user:udyam_password@localhost:5432/udyam_db

# ── Backend ───────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-string
VERSION=1.0.0

# ── AI / LLM API Keys ────────────────────────────────────
# At least one is required for the AI Advisor feature
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
