# UdyamAI Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://udyam_user:udyam_password@localhost:5432/udyam_db

# ── Backend ───────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-string
VERSION=1.0.0

# ── AI / LLM & Voice API Keys ───────────────────────────
# At least one is required for the AI Advisor feature
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# ── Sarvam AI (Speech-to-Text & Text-to-Speech) ───────────
SARVAM_API_KEY=your-sarvam-subscription-key-here
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_DEFAULT_SPEAKER=meera

# ── Supabase Auth ──────────────────────────────────────────
# Project URL (Settings -> API) and the public anon key, used by the frontend.
# Copy these into frontend/.env as well when running the Next.js app locally.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# JWT secret used to verify Supabase access tokens server-side
# (Project Settings -> API -> JWT Settings).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── WhatsApp / Twilio channel (optional) ──────────────────
# Inbound WhatsApp: Twilio POSTs to /webhooks/whatsapp and the backend replies
# with TwiML. Left off by default so an unconfigured deploy exposes nothing.
# See docs/whatsapp-channel.md for the full enablement walkthrough.
# WHATSAPP_ENABLED=false

# Auth Token from the Twilio Console (Account Info). This is the key Twilio signs
# webhook requests with, so it is required only when verification is enabled.
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# WHATSAPP_VERIFY_SIGNATURE=false

# The exact public URL Twilio was configured to call. Needed behind a proxy, where
# the app would otherwise reconstruct an internal http:// URL and reject a
# legitimate signature. Must match the console value byte for byte.
# TWILIO_WEBHOOK_URL=https://your-public-host/webhooks/whatsapp

# Per-sender throttle, keyed on the WhatsApp number rather than the client IP
# (Twilio's egress IPs are shared, so a per-IP limit would throttle all tenants).
# WHATSAPP_RATE_LIMIT_REQUESTS=20
# WHATSAPP_RATE_LIMIT_WINDOW=60

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
